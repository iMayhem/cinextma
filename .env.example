# For Cloudflare: LEAVE EMPTY to use the Functions proxy (avoids Mixed Content)
# For VPS self-hosting: leave empty too (Caddy routes /api/* to the scraper API)
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_TMDB_ACCESS_TOKEN=your_tmdb_access_token

# VPS only
JWT_SECRET=generate_a_long_random_string
SCRAPERS_BASE=http://scraper-api:8080
